{
    "name": "matrimony-backend",
    "version": "1.0.0",
    "description": "Production-grade Matrimony Backend",
    "main": "dist/server.js",
    "scripts": {
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "start": "npm run build && node dist/server.js",
        "dev": "nodemon",
        "build": "tsc && tsc-alias && echo 'Build Finished! 👍'",
        "lint": "eslint --ignore-path .gitignore --ext .ts src/",
        "lint:fix": "npm run lint -- --fix",
        "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
        "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
        "migration:generate": "sequelize migration:generate --name",
        "migration": "sequelize db:migrate",
        "seed:tamilnadu": "ts-node -r tsconfig-paths/register src/database/test_folder/tamil-nadu-seed.ts",
        "seed:tamilnadu:clean": "ts-node -r tsconfig-paths/register src/database/test_folder/tamil-nadu-seed.ts --clean"
    },
    "author": "Saran K S",
    "license": "MIT",
    "dependencies": {
        "@aws-sdk/client-s3": "3.696",
        "@aws-sdk/s3-request-presigner": "3.696",
        "@socket.io/redis-adapter": "^8.3.0",
        "bcrypt": "^6.0.0",
        "cors": "^2.8.5",
        "dotenv": "^17.2.2",
        "express": "^5.1.0",
        "express-rate-limit": "^8.4.1",
        "helmet": "^8.1.0",
        "joi": "^17.13.3",
        "jsonwebtoken": "^9.0.2",
        "ms": "^2.1.3",
        "mysql2": "^3.15.0",
        "pg": "^8.13.0",
        "pg-hstore": "^2.3.4",
        "pino": "^9.14.0",
        "pino-pretty": "^12.1.0",
        "rate-limit-redis": "^4.3.1",
        "redis": "^5.12.1",
        "sequelize": "^6.37.4",
        "sequelize-typescript": "^2.1.6",
        "socket.io": "^4.8.3",
        "swagger-jsdoc": "^6.2.8",
        "swagger-ui-express": "^5.0.1",
        "tsconfig-paths": "^4.2.0",
        "twilio": "^5.10.0",
        "validator": "^13.15.35",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@types/bcrypt": "^5.0.2",
        "@types/cors": "^2.8.17",
        "@types/express": "^5.0.0",
        "@types/jest": "^29.5.14",
        "@types/jsonwebtoken": "^9.0.7",
        "@types/mocha": "^10.0.10",
        "@types/ms": "^2.1.0",
        "@types/node": "^24.12.2",
        "@types/pg": "^8.11.10",
        "@types/sequelize": "^4.28.20",
        "@types/supertest": "^7.2.0",
        "@types/swagger-jsdoc": "^6.0.4",
        "@types/swagger-ui-express": "^4.1.6",
        "@types/validator": "^13.12.0",
        "@typescript-eslint/eslint-plugin": "^8.44.0",
        "@typescript-eslint/parser": "^8.44.0",
        "eslint": "^9.36.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.4",
        "jest": "^29.7.0",
        "nodemon": "^3.1.7",
        "prettier": "^3.6.2",
        "sequelize-cli": "^6.6.2",
        "supertest": "^7.0.0",
        "ts-jest": "^29.4.9",
        "ts-node": "^10.9.2",
        "tsc-alias": "^1.8.10",
        "typescript": "^5.7.3"
    }
}
